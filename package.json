{
  "name": "video-speed-controller",
  "version": "1.0.0",
  "description": "Chrome extension for controlling video playback speed",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "node tests/e2e/run-tests.js"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "puppeteer": "^21.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "*.js",
      "!tests/**",
      "!node_modules/**"
    ]
  }
}
